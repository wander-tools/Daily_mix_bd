# ================================================================
# Daily Mix BD - Environment Variables Configuration Template
# Copy this file to '.env' in your local development environment:
#   cp .env.example .env
# ================================================================

# Application Server Port (Default: 3000)
PORT=3000

# Node Environment: 'development' or 'production'
NODE_ENV=development

# Base URL of the Application
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Courier API Configurations (Optional environment overrides; also configurable in Admin > Couriers)
# STEADFAST_API_KEY="YOUR_STEADFAST_API_KEY"
# STEADFAST_SECRET_KEY="YOUR_STEADFAST_SECRET_KEY"
# PATHAO_CLIENT_ID="YOUR_PATHAO_CLIENT_ID"
# PATHAO_CLIENT_SECRET="YOUR_PATHAO_CLIENT_SECRET"
# REDX_API_TOKEN="YOUR_REDX_API_TOKEN"

# SMS Gateway Configuration (Optional; also configurable in Admin > Notifications)
# SMS_GATEWAY_API_KEY="YOUR_SMS_GATEWAY_API_KEY"
# SMS_GATEWAY_PROVIDER="greenweb"
